# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://studybuddy:studybuddy@localhost:5432/studybuddy

# Moodle (token auth, see login/token.php). Users normally connect their own
# account in the web UI; MOODLE_TOKEN is an optional fallback used only for
# MOODLE_TOKEN_OWNER (empty owner = nobody; the token is then unused).
MOODLE_BASE_URL=https://elearning.strathmore.edu
MOODLE_TOKEN=
MOODLE_TOKEN_OWNER=

# Google Classroom OAuth (Web application type, Testing status)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional shared refresh token, used only for GOOGLE_REFRESH_TOKEN_OWNER
# (users normally get their own at Google sign-in; empty owner = nobody)
GOOGLE_REFRESH_TOKEN=
GOOGLE_REFRESH_TOKEN_OWNER=

# LLM (OpenAI-compatible endpoint; chunking uses the cheap model)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHUNK_MODEL=gemini-3.6-flash
LLM_QUIZ_MODEL=gemini-3.6-flash
LLM_GRADE_MODEL=gemini-3.6-flash
# seconds between pipeline LLM calls (0 = none; free tiers need ~5-45)
LLM_PACE=0

# Notifications (Resend free tier: api.resend.com, verified sender required)
RESEND_API_KEY=
# Public origin used for links in emails (e.g. https://<service>-<number>.<region>.run.app)
APP_BASE_URL=http://localhost:8000
# Proxies uvicorn trusts for X-Forwarded-For/-Proto (IPs or CIDRs). Docker and
# Procfile default to "*"; narrow it when the proxy address is known (DEPLOY.md).
# FORWARDED_ALLOW_IPS=10.0.0.0/8
# Sender on a domain verified in Resend (e.g. Study Buddy <study@example.com>);
# while it is empty nothing is sent and notifications wait in the queue
EMAIL_FROM=
# Fallback recipient for events with no owner; owned events go to User.email
EMAIL_TO=

# IANA zone whose midnight starts a study day (streaks on /stats)
TIMEZONE=Africa/Nairobi

# Web sessions (generate: openssl rand -hex 32; set cookie secure in prod)
SECRET_KEY=dev-insecure-change-me
SESSION_SECURE_COOKIE=false
# The default SECRET_KEY above is public and refused unless DEV=1.
# Uncomment for local development only, never on a server.
# DEV=1
# How long a sign-in lasts without use, in seconds (default 7 days)
SESSION_MAX_AGE=604800
# Who may sign in: comma-separated addresses and/or "@domain" entries.
# Empty = any Google account may sign in (strangers see nothing, but get a session).
ALLOWED_EMAILS=@strathmore.edu
# Dead-man's-switch for cron (e.g. https://healthchecks.io check ping URL).
# Worker GETs it after every pass, or <url>/fail when a job failed or the
# pass crashed; empty = disabled.
HEALTHCHECK_PING_URL=
# Days to keep completed/failed jobs before the worker deletes them.
JOB_RETENTION_DAYS=30
